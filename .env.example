# ── Supabase (frontend) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Providers (extractor-api) — copy to packages/extractor-api/.env también ─
GOOGLE_PLACES_API_KEY=
FOURSQUARE_API_KEY=
YELP_API_KEY=

# Overpass es gratis y no necesita key.
# Habilitá solo los providers que tengas configurados:
ENABLED_PROVIDERS=overpass
