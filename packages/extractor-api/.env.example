# ── Providers ────────────────────────────────────────────────────────────────
#
# OVERPASS (OpenStreetMap) — GRATIS, sin registro, funciona sin API key.
#   Datos de todo el mundo: comercios, restaurants, bancos, hospitales, etc.
#
# GOOGLE PLACES — De pago con crédito gratuito: USD 200/mes ≈ 5000 búsquedas.
#   Registro: https://console.cloud.google.com → Biblioteca → Places API (New)
GOOGLE_PLACES_API_KEY=

# FOURSQUARE — Plan gratuito: 1000 llamadas/día.
#   Registro: https://location.foursquare.com/developer → Create App
FOURSQUARE_API_KEY=

# YELP FUSION — Plan gratuito: 500 llamadas/día.
#   Registro: https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=

# ── Providers activos ────────────────────────────────────────────────────────
# Separados por coma. Para empezar solo con Overpass (gratis):
ENABLED_PROVIDERS=overpass
# Para usar todos los que tengan key:
# ENABLED_PROVIDERS=overpass,google,foursquare,yelp

# ── Base de datos (SQLite local, no requiere cambios) ─────────────────────────
DATABASE_URL=sqlite:////app/data/searches.db

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3100
